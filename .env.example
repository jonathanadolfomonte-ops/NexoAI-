# Copia este archivo como .env para probar en tu computadora.
# En el hosting (Render, etc.) cargá estas mismas variables en su panel.
# NUNCA subas el archivo .env real a GitHub: el repo es publico.

ANTHROPIC_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=inventa-una-clave-larga-aqui
META_APP_SECRET=

# Opcionales
GROQ_API_KEY=
# Número personal que enviará mensajes al número de WhatsApp conectado a la API (solo dígitos, formato internacional).
# Las respuestas saldrán desde el número de WhatsApp conectado a la API, no desde el número personal.
PERSONAL_WHATSAPP_NUMBER=
GROQ_MODEL=openai/gpt-oss-20b
CLAUDE_MODEL=claude-sonnet-5-5
WHATSAPP_API_VERSION=v21.0

# Registro de conversaciones en una planilla de Google (opcional)
WEBHOOK_PLANILLA_URL=
PLANILLA_CLAVE=
